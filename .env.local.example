# ============================================================
# JobPilot — Variables d'environnement
# Copiez ce fichier en .env.local et remplissez les valeurs
# ATTENTION : Ne jamais commiter .env.local sur GitHub
# ============================================================

# --- Supabase (obligatoire) ---
# Trouvez ces valeurs dans : Supabase Dashboard → Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://abmnrqzntphgakwqoqin.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=votre-anon-key-ici

# Clé service_role — uniquement pour les API routes serveur, JAMAIS exposée côté client
SUPABASE_SERVICE_ROLE_KEY=votre-service-role-key-ici

# --- Optionnel : Scraper externe (Render) ---
# URL du service de scraping si déployé séparément
# SCRAPER_API_URL=https://votre-scraper.onrender.com
# SCRAPER_API_KEY=votre-cle-scraper

# --- Optionnel : Email (Resend) ---
# Pour les notifications email
# RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxx

# --- Optionnel : Sentry (error tracking) ---
# NEXT_PUBLIC_SENTRY_DSN=https://xxx@xxx.ingest.sentry.io/xxx
